rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The allowlist has no client access; manage it with `pnpm allowlist` or the console.
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }

    function isValidList(data) {
      return data.keys().hasOnly(['name', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.createdAt is int;
    }

    function isValidItem(data) {
      return data.keys().hasOnly(['listId', 'text', 'done', 'createdAt'])
        && data.listId is string
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.done is bool
        && data.createdAt is int;
    }

    match /lists/{listId} {
      allow read, delete: if isAllowed();
      allow create, update: if isAllowed() && isValidList(request.resource.data);
    }

    match /items/{itemId} {
      allow read, delete: if isAllowed();
      allow create, update: if isAllowed() && isValidItem(request.resource.data);
    }
  }
}
