{
  "name": "checklist",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "prepare": "husky",
    "start": "vite",
    "start:emulator": "firebase emulators:exec --only auth,firestore --project demo-checklist 'vite --mode emulator'",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "sync-allowlist": "node scripts/sync-allowlist.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-checklist 'vitest run'",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "dependencies": {
    "beercss": "^5.0.3",
    "firebase": "^13.1.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-solid": "^0.18.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
